# Formspree form ID (from https://formspree.io/f/YOUR_ID)
# Used by Contact Us and Book Appointment pages
VITE_FORMSPREE_FORM_ID=

# Shop payment mode: demo | stripe
# demo  = simulated checkout (default, no real charges)
# stripe = live Stripe (requires keys + backend below)
VITE_PAYMENT_MODE=demo

# Stripe publishable key (pk_test_... or pk_live_...)
# Only used when VITE_PAYMENT_MODE=stripe
VITE_STRIPE_PUBLISHABLE_KEY=

# Backend endpoint that creates a Stripe PaymentIntent (server-side secret key required)
VITE_STRIPE_PAYMENT_INTENT_URL=/api/create-payment-intent

# Optional: external patient portal sign-in URL (shows portal login when set)
VITE_PATIENT_PORTAL_URL=

# Optional: Google Business Profile / Maps reviews URL for the reviews widget
VITE_GOOGLE_REVIEWS_URL=

# Patient portal API (proxied to backend in dev via vite.config.js)
VITE_API_URL=/api
