# Formspree form ID (from https://formspree.io/f/YOUR_ID)
# Used by Contact Us and Book Appointment screens
VITE_FORMSPREE_FORM_ID=

# Patient portal API — local backend (Windows / iOS simulator / web)
# Android emulator: http://10.0.2.2:4000/api
VITE_API_URL=http://127.0.0.1:4000/api

# Optional: legacy external patient portal URL
VITE_PATIENT_PORTAL_URL=

# Optional: Google Business Profile / Maps reviews URL
VITE_GOOGLE_REVIEWS_URL=
