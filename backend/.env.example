# Local dev (SQLite). For production, use PostgreSQL — see docker-compose.yml
DATABASE_URL="file:./dev.db"

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
COOKIE_NAME=portal_token
STAFF_COOKIE_NAME=staff_token

# OTP — dev mode logs codes to console instead of sending SMS
OTP_DEV_MODE=true

# Twilio (production SMS) — only needed when OTP_DEV_MODE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
